{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.local.panorama-viewer",
  "version": "0.1.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/web-dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": false,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "modes": {
    "window": {
      "title": "Panorama Viewer Local",
      "width": 1440,
      "height": 900,
      "minWidth": 1024,
      "minHeight": 640,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "PanoramaViewerLocal",
    "resourcesPath": "/web-dist/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/web-dist/js/neutralino.js",
    "binaryVersion": "6.8.0",
    "clientVersion": "6.8.0"
  }
}
